# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json

# Claude Code — local/personal, not committed
CLAUDE.md
**/.claude
**/superpowers
**/.superpowers
**/docs/

# Copied out of node_modules/pdfjs-dist at build time by the copy-pdfjs-wasm plugin in
# vite.config.ts. Never commit these: a checked-in copy silently goes stale against the installed
# pdfjs-dist, and the symptom of a version mismatch is a scanned page that renders BLANK.
public/pdfjs-wasm/
